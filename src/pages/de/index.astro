---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Domov">
  <!-- Hero Section -->
  <section style="background: linear-gradient(to right, #eff6ff, #dbeafe); padding: 5rem 0;">
    <div style="max-width: 64rem; margin: 0 auto; padding: 0 1rem;">
      <div style="text-align: center;">
        <h1 style="font-size: 3rem; font-weight: 700; color: #111827; margin-bottom: 1.5rem;">
          Návrh a tvorba nábytku na mieru
        </h1>
        <p style="font-size: 1.25rem; color: #4b5563; margin-bottom: 2rem;">
          Realizujeme individuálne projekty pre domácnosti aj kancelárie
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center;">
          <a href="#contact" style="background-color: #2563eb; color: white; padding: 0.75rem 2rem; border-radius: 0.375rem; font-weight: 600; text-decoration: none;">
            Napísať nám
          </a>
          <a href="#gallery" style="border: 2px solid #2563eb; color: #2563eb; padding: 0.75rem 2rem; border-radius: 0.375rem; font-weight: 600; text-decoration: none;">
            Pozrieť galériu
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section style="padding: 4rem 0; background: white;">
    <div style="max-width: 64rem; margin: 0 auto; padding: 0 1rem;">
      <h2 style="font-size: 2.25rem; font-weight: 700; color: #111827; margin-bottom: 3rem; text-align: center;">O nás</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <div style="background: #f9fafb; padding: 2rem; border-radius: 0.5rem;">
          <h3 style="font-size: 1.5rem; font-weight: 700; color: #2563eb; margin-bottom: 1rem;">01. Návrh</h3>
          <p style="color: #4b5563;">Počúvame vaše predstavy a vytvárame profesionálny návrh presne podľa vašich potrieb a priestoru.</p>
        </div>
        <div style="background: #f9fafb; padding: 2rem; border-radius: 0.5rem;">
          <h3 style="font-size: 1.5rem; font-weight: 700; color: #2563eb; margin-bottom: 1rem;">02. Výroba</h3>
          <p style="color: #4b5563;">Používame kvalitné materiály a precíznu manuálnu výrobu s dôrazom na detaily a odbornosť.</p>
        </div>
        <div style="background: #f9fafb; padding: 2rem; border-radius: 0.5rem;">
          <h3 style="font-size: 1.5rem; font-weight: 700; color: #2563eb; margin-bottom: 1rem;">03. Dodanie</h3>
          <p style="color: #4b5563;">Profesionálne osadenie, testovanie a prevzatie s vašou úplnou spokojnosťou.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section style="padding: 4rem 0; background-color: #2563eb; color: white;">
    <div style="max-width: 64rem; margin: 0 auto; padding: 0 1rem; text-align: center;">
      <h2 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 2rem;">Máte nápad? Poďme ho realizovať!</h2>
      <a href="#contact" style="background-color: white; color: #2563eb; padding: 0.75rem 2rem; border-radius: 0.375rem; font-weight: 700; text-decoration: none; display: inline-block;">
        Kontaktujte nás
      </a>
    </div>
  </section>
</Layout>
